# Copy this file to .env.tidb-migration and replace every placeholder.
# The real file is ignored by Git. Restrict it with: chmod 600 .env.tidb-migration

# Source production MySQL
SOURCE_DB_HOST='<MYSQL_HOST>'
SOURCE_DB_PORT='3306'
SOURCE_DB_NAME='mahis_moses'
SOURCE_DB_USERNAME='<MYSQL_USER>'
SOURCE_DB_PASSWORD='<MYSQL_PASSWORD>'
SOURCE_SSL_MODE='VERIFY_IDENTITY'
SOURCE_SSL_CA='/path/to/mysql-ca.pem'

# Target production TiDB
TARGET_DB_HOST='<TIDB_HOST>'
TARGET_DB_PORT='4000'
TARGET_DB_NAME='mahis_moses'
TARGET_DB_USERNAME='<TIDB_USER>'
TARGET_DB_PASSWORD='<TIDB_PASSWORD>'
TARGET_SSL_MODE='VERIFY_IDENTITY'
TARGET_SSL_CA='/path/to/tidb-ca.pem'

# Optional TiDB administrator used only to create TARGET_DB_NAME and grant the
# scoped target user. Omit these when the database and grant already exist.
TARGET_ADMIN_USERNAME='<TIDB_ADMIN_USER>'
TARGET_ADMIN_PASSWORD='<TIDB_ADMIN_PASSWORD>'
TARGET_DB_USER_HOST='%'

# Local Docker only: optionally pause TiFlash during a memory-intensive import.
# Leave unset for production and non-Docker clusters.
# LOCAL_TIFLASH_CONTAINER='mahis-tidb-tiflash'
TIDB_READY_TIMEOUT='120'

# Comma-separated rebuildable cache tables whose schema is migrated without
# rows. Individual TiDB row entries are limited to 6 MiB by default.
EXCLUDED_TABLE_DATA='immunization_cache_data'

# Remove source-only MySQL DEFINER=user@host clauses from views. The view SQL
# and its SQL SECURITY mode remain unchanged.
STRIP_DEFINERS='true'

# When true, an unsuccessful import removes its partial target database. Keep
# false in production when failed state must be retained for investigation.
DROP_TARGET_ON_FAILURE='false'

# Output and verification
DUMP_DIR='tmp/tidb_migrations'
VERIFY_ROW_COUNTS='true'

# Optional client overrides. Normally leave these unset: the script discovers
# Homebrew mysql-client@8.4 on macOS and uses PATH on Ubuntu/Linux.
# MYSQL_CLIENT='/custom/path/to/mysql'
# MYSQLDUMP_CLIENT='/custom/path/to/mysqldump'

# Change to true only after every process writing to MySQL has been stopped.
CONFIRM_SOURCE_WRITES_STOPPED='false'
