healthdata:
  adapter: mysql2
  host: <%= ENV.fetch("HEALTHDATA_DB_HOST", "localhost") %>
  port: <%= ENV.fetch("HEALTHDATA_DB_PORT", 3306) %>
  username: <%= ENV.fetch("HEALTHDATA_DB_USERNAME", "root") %>
  database: <%= ENV.fetch("HEALTHDATA_DB_NAME", "healthdata") %>
  password: <%= ENV.fetch("HEALTHDATA_DB_PASSWORD", "") %>
  pool: <%= ENV.fetch("HEALTHDATA_DB_POOL", 5) %>

# metadata_server:
#  adapter: mysql2
#  username: root
#  database: openmrs
#  password:
#  host: localhost
#  pool: 500

centralized_source_db:
  <<: *default
  host: <%= ENV.fetch("SOURCE_DB_HOST", "127.0.0.1") %>
  port: <%= ENV.fetch("SOURCE_DB_PORT", 3306) %>
  username: <%= ENV.fetch("SOURCE_DB_USERNAME", "root") %>
  password: <%= ENV.fetch("SOURCE_DB_PASSWORD", "") %>
  database: <%= ENV.fetch("SOURCE_DB_NAME", "mpc") %>
  ssl_mode: <%= ENV.fetch("SOURCE_DB_SSL_MODE", "disabled") %>
  sslca: <%= ENV["SOURCE_DB_SSL_CA"] %>
