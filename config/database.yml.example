# MySQL/TiDB configuration. Set TIDB_ENABLED=true to use TiDB defaults.
<% tidb_enabled = %w[1 true yes on].include?(ENV.fetch("TIDB_ENABLED", "").downcase) %>
default: &default
  adapter: mysql2
  host: <%= ENV.fetch("DB_HOST", "127.0.0.1") %>
  port: <%= ENV.fetch("DB_PORT", tidb_enabled ? 4000 : 3306) %>
  encoding: <%= ENV.fetch("DB_ENCODING", "utf8mb4") %>
  collation: <%= ENV.fetch("DB_COLLATION", "utf8mb4_unicode_ci") %>
  username: <%= ENV.fetch("DB_USERNAME", "root") %>
  password: <%= ENV.fetch("DB_PASSWORD", "") %>
  pool: <%= ENV.fetch("DB_POOL") { ENV.fetch("RAILS_MAX_THREADS") { 5 } } %>
  checkout_timeout: <%= ENV.fetch("DB_CHECKOUT_TIMEOUT") { 5 } %>
  connect_timeout: <%= ENV.fetch("DB_CONNECT_TIMEOUT", 10) %>
  read_timeout: <%= ENV.fetch("DB_READ_TIMEOUT", 30) %>
  write_timeout: <%= ENV.fetch("DB_WRITE_TIMEOUT", 30) %>
  ssl_mode: <%= ENV.fetch("DB_SSL_MODE", tidb_enabled ? "verify_identity" : "disabled") %>
  sslca: <%= ENV["DB_SSL_CA"] %>
  advisory_locks: true
  variables:
    sql_mode: <%= ENV.fetch("DB_SQL_MODE", "STRICT_TRANS_TABLES") %>

development:
  <<: *default
  database: <%= ENV.fetch("DB_NAME", "openmrs_dev") %>

test:
  <<: *default
  database: <%= ENV.fetch("DB_TEST_NAME", "openmrs_test") %>

production:
  <<: *default
  database: <%= ENV.fetch("DB_NAME", "openmrs_prod") %>

# Uncomment out the following and update them accordingly if
