immunization_stats_midnight_refresh:
  cron: "0 0 * * *"
  class: "ImmunizationMidnightRefreshJob"
  queue: "default"
  description: "Refreshes the immunization stats at midnight"

mnh_stats_changed_refresh:
  cron: "30 1 * * *"
  class: "Sync::MnhStatsSyncJob"
  queue: "sync_offline_data"
  args:
    - ~      # date (nil = all-time)
    - 5000   # batch_size
    - ~      # location_id (nil = dispatch/fan-out)
    - ~      # program_key (nil = all MNH programs)
    - true   # changed_only: only facilities active in the last 48h
  description: "Nightly changed-only MNH stats refresh (fans out one job per active facility)"

mnh_stats_full_refresh:
  cron: "30 3 * * 0"
  class: "Sync::MnhStatsSyncJob"
  queue: "sync_offline_data"
  description: "Weekly full MNH stats rebuild for every DDE-activated facility (fans out one job per facility)"

flag_potential_duplicates:
  cron: "0 0 * * *"
  class: "FlagPotentialDuplicatesJob"
  queue: "default"
  description: "Flags potential duplicates at midnight"

dde_ids_sync_job:
  cron: "*/15 * * * *" # every 15 minutes
  class: "Sync::DdeIdsSyncJob"
  queue: default

referral_status_retry_job:
  cron: "*/15 * * * *" # every 15 minutes
  class: "ReferralStatusRetryJob"
  queue: default
  args:
    - 100
    - 720
  description: "Retries MAHIS -> iCHIS referral status updates for recent referrals"

